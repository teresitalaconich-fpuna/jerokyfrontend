# Frontend Production Environment Configuration
# Note: In Next.js, NEXT_PUBLIC_* variables are also required as Build Args in Dokploy

# Server Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Backend API Public URL
# Set this to the public URL where your backend API is accessible
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com/api
