FROM node:22-alpine

WORKDIR /app

# Copy package files first
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose Next.js port
EXPOSE 3000

# Set environment variable to run Next.js properly inside Docker
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Run next dev for development hot reload
CMD ["npm", "run", "dev"]
